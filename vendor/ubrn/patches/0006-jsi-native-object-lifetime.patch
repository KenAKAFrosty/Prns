+static OBJECTS_CREATED: AtomicU32 = AtomicU32::new(0);
+static OBJECTS_DROPPED: AtomicU32 = AtomicU32::new(0);
+static OBJECT_CLAIMED: AtomicBool = AtomicBool::new(false);
+static OBJECT_WAITS_STARTED: AtomicU32 = AtomicU32::new(0);
+static OBJECT_WAITS_DROPPED: AtomicU32 = AtomicU32::new(0);
