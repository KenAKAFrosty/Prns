+class RustObjectRegistry : public std::enable_shared_from_this<RustObjectRegistry> {
+  struct Entry {
+    uint64_t pointer;
+    std::string freeName;
+  };
+
+public:
+  RustObjectRegistry(UbrnJsiModule *module,
+                     std::shared_ptr<facebook::react::CallInvoker> invoker,
+                     std::weak_ptr<void> root)
