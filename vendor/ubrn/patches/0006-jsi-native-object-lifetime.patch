+++ b/fixtures/reload-safety/tests/bindings/test_reload_objects.ts
@@ -0,0 +1,176 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/
+ */
+import { asyncTest } from "@/asserts";
+import theModule, {
+  activeObjectCount,
+  activeObjectWaitCount,
+  cloneReloadObject,
+  noteIteration,
+  objectClaimAvailable,
+  objectCreatedCount,
+  objectDropCount,
+  ReloadObject,
+  tryClaimReloadObject,
+} from "@/generated/reload_safety";
+
+theModule.initialize();
+
+declare const __testRequestReload: () => void;
+const delay = () => new Promise<void>((resolve) => setTimeout(resolve, 0));
+const gc = (globalThis as any).__hermesGc as (() => void) | undefined;
+
+function claimedObject(): ReloadObject {
+  const object = tryClaimReloadObject();
+  if (!(object instanceof ReloadObject)) {
+    throw new Error("Previous runtime still owns the native object claim");
+  }
+  return object;
+}
+
+function abandonObject(): void {
+  const object = new ReloadObject();
+  if (object.serial() === 0) throw new Error("Object was not constructed");
+}
+
+void asyncTest(
+  "native objects release once across GC and runtime replacement",
+  async (t) => {
+    const iteration = noteIteration();
+    t.assertEqual(
+      activeObjectCount(),
+      0,
+      "old runtime released every object reference",
+    );
+    t.assertEqual(
+      activeObjectWaitCount(),
+      0,
+      "old runtime released pending object methods",
+    );
+    t.assertTrue(
+      objectClaimAvailable(),
+      "old runtime released its exclusive claim",
+    );
+    t.assertEqual(
+      objectCreatedCount(),
+      objectDropCount(),
+      "each old object dropped exactly once",
+    );
+
+    const beforeExplicit = objectDropCount();
+    const explicit = new ReloadObject();
+    explicit.uniffiDestroy();
+    explicit.uniffiDestroy();
+    t.assertEqual(activeObjectCount(), 0);
+    t.assertEqual(
+      objectDropCount(),
+      beforeExplicit + 1,
+      "explicit destroy is idempotent",
+    );
+
+    const original = new ReloadObject();
+    const alias = cloneReloadObject(original);
+    if (!(alias instanceof ReloadObject))
+      throw new Error("Clone did not produce an object wrapper");
+    const serial = original.serial();
+    original.uniffiDestroy();
+    t.assertEqual(
+      activeObjectCount(),
+      1,
+      "each wrapper owns its own native reference",
+    );
+    t.assertEqual(
+      alias.serial(),
+      serial,
+      "two wrappers may share the same Arc pointer",
+    );
+    alias.uniffiDestroy();
+    t.assertEqual(activeObjectCount(), 0);
+    t.assertEqual(objectDropCount(), beforeExplicit + 2);
+
+    // The asynchronous method owns a separate Arc. Releasing the JS object must
+    // not invalidate it; cancelling and freeing the future releases the last Arc.
+    const borrowed = claimedObject();
+    const abort = new AbortController();
+    const pending = borrowed.wait({ signal: abort.signal });
+    t.assertEqual(activeObjectWaitCount(), 1);
+    borrowed.uniffiDestroy();
+    borrowed.uniffiDestroy();
+    t.assertEqual(activeObjectCount(), 1);
+    t.assertFalse(objectClaimAvailable());
+    abort.abort();
+    let aborted = false;
+    try {
+      await pending;
+    } catch (error) {
+      aborted = (error as Error).name === "AbortError";
+    }
+    t.assertTrue(aborted);
+    t.assertEqual(activeObjectWaitCount(), 0);
+    t.assertEqual(activeObjectCount(), 0);
+    t.assertTrue(objectClaimAvailable());
+    t.assertEqual(objectDropCount(), beforeExplicit + 3);
+
+    if (gc !== undefined) {
+      const beforeGc = objectDropCount();
+      abandonObject();
+      t.assertEqual(activeObjectCount(), 1);
+      for (
+        let attempt = 0;
+        attempt < 10 && activeObjectCount() !== 0;
+        attempt++
+      ) {
+        gc();
+        await delay();
+      }
+      t.assertEqual(
+        activeObjectCount(),
+        0,
+        "ordinary GC releases abandoned object",
+      );
+      t.assertEqual(
+        objectDropCount(),
+        beforeGc + 1,
+        "GC releases exactly one reference",
+      );
+      gc();
+      await delay();
+      t.assertEqual(
+        objectDropCount(),
+        beforeGc + 1,
+        "later GC does not free destroyed handles again",
+      );
+    }
+
+    const held = new ReloadObject();
+    const claimed = claimedObject();
+    const waiting = claimed.wait();
+    // These are deliberately reachable until runtime destruction. Ordinary GC
+    // must not hide an omitted runtime-level cleanup step.
+    (globalThis as any).__abandonedReloadObjects = {
+      held,
+      claimed,
+      waiting,
+      explicit,
+      borrowed,
+      original,
+      alias,
+    };
+    t.assertEqual(activeObjectCount(), 2);
+    t.assertEqual(activeObjectWaitCount(), 1);
+    t.assertFalse(objectClaimAvailable());
+    t.assertEqual(
+      tryClaimReloadObject(),
+      undefined,
+      "a live object's claim remains exclusive",
+    );
+    console.info(
+      `iteration ${iteration}: exact-once destroy/GC passed; 2 objects and 1 method abandoned`,
+    );
+    t.end();
+    __testRequestReload();
+  },
+  10000,
+);
