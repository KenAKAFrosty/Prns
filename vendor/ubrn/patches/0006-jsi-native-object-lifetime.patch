+/// An object whose last native reference owns an exclusive process-wide claim.
+/// The claim deliberately survives JS replacement unless every object/future
+/// reference from the old runtime is released.
+#[derive(uniffi::Object)]
+pub struct ReloadObject {
+    serial: u32,
+    claimed: bool,
+}
+
+impl ReloadObject {
+    fn create(claimed: bool) -> Arc<Self> {
+        Arc::new(Self {
+            serial: OBJECTS_CREATED.fetch_add(1, Ordering::SeqCst) + 1,
+            claimed,
+        })
+    }
+}
+
+impl Drop for ReloadObject {
+    fn drop(&mut self) {
+        if self.claimed {
+            OBJECT_CLAIMED.store(false, Ordering::SeqCst);
+        }
+        OBJECTS_DROPPED.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+struct PendingObjectWait;
+
+impl Drop for PendingObjectWait {
+    fn drop(&mut self) {
+        OBJECT_WAITS_DROPPED.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+#[uniffi::export]
+impl ReloadObject {
+    #[uniffi::constructor]
+    pub fn new() -> Arc<Self> {
+        Self::create(false)
+    }
+
+    pub fn serial(&self) -> u32 {
+        self.serial
+    }
+
+    /// Only cancellation or runtime teardown can finish this wait. No worker or
+    /// deadline can release its captured object and conceal a teardown leak.
+    pub async fn wait(&self) -> u32 {
+        OBJECT_WAITS_STARTED.fetch_add(1, Ordering::SeqCst);
+        let _wait = PendingObjectWait;
+        std::future::pending::<()>().await;
+        self.serial
+    }
+}
+
+#[uniffi::export]
+pub fn try_claim_reload_object() -> Option<Arc<ReloadObject>> {
+    OBJECT_CLAIMED
+        .compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst)
+        .ok()
+        .map(|_| ReloadObject::create(true))
+}
+
+#[uniffi::export]
+pub fn clone_reload_object(object: Arc<ReloadObject>) -> Arc<ReloadObject> {
+    object
+}
+
+#[uniffi::export]
+pub fn active_object_count() -> u32 {
+    OBJECTS_CREATED.load(Ordering::SeqCst) - OBJECTS_DROPPED.load(Ordering::SeqCst)
+}
+
+#[uniffi::export]
+pub fn object_drop_count() -> u32 {
+    OBJECTS_DROPPED.load(Ordering::SeqCst)
+}
+
+#[uniffi::export]
+pub fn object_created_count() -> u32 {
+    OBJECTS_CREATED.load(Ordering::SeqCst)
+}
+
+#[uniffi::export]
+pub fn object_claim_available() -> bool {
+    !OBJECT_CLAIMED.load(Ordering::SeqCst)
+}
+
+#[uniffi::export]
+pub fn active_object_wait_count() -> u32 {
+    OBJECT_WAITS_STARTED.load(Ordering::SeqCst) - OBJECT_WAITS_DROPPED.load(Ordering::SeqCst)
+}
