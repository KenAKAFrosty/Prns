+test("Tuple variant preserves optional field types", (t) => {
+  const absent = OptionalFields.Tuple.new(undefined, undefined);
+  const absentRoundTripped = identityOptionalFields(absent);
+  if (OptionalFields.Tuple.instanceOf(absentRoundTripped)) {
+    t.assertEqual(absentRoundTripped.inner[0], undefined);
+    t.assertEqual(absentRoundTripped.inner[1], undefined);
+  } else {
+    t.fail("expected Tuple");
+  }
+
+  const present = new OptionalFields.Tuple(
+    "value",
+    AnimalRecord.create({ value: 7 }),
+  );
+  const presentRoundTripped = identityOptionalFields(present);
+  if (OptionalFields.Tuple.instanceOf(presentRoundTripped)) {
+    t.assertEqual(presentRoundTripped.inner[0], "value");
+    t.assertEqual(presentRoundTripped.inner[1]?.value, 7);
+  } else {
+    t.fail("expected Tuple");
+  }
+});
+
