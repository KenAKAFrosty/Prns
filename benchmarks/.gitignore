# External-impl drivers: cloned upstreams and build artifacts are never committed —
# `external/<impl>/run.sh` regenerates them. We commit only our harness + run.sh + README.
external/*/.upstream/
external/*/build/
external/*/build-mt/
external/*/harness/target/
external/*/harness/Cargo.lock
external/*/harness-mt/target/
external/*/harness-mt/Cargo.lock

# Energy harness build artifacts — energy/build.sh regenerates them.
energy/contestants/*/target/
energy/contestants/*/Cargo.lock
energy/contestants/go/sustained-go
energy/contestants/rns-cr/bench_sustained
energy/contestants/rns-cr/bench_sustained.dwarf
energy/contestants/microreticulum/build/
