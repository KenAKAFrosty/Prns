#!/usr/bin/env bash
# Pre-push hygiene gate: rustfmt-clean (root + app workspaces) and intra-doc
# links resolve, before anything reaches origin — so unformatted code or a
# broken doc link can never break `ci` again. Reuses the canonical check.
#
# Enable once per clone:   git config core.hooksPath scripts/hooks
# Bypass (discouraged):    git push --no-verify
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"

if ! "${repo_root}/scripts/fmt-check.sh"; then
    echo ""
    echo "✗ push blocked by the hygiene gate (see above)."
    echo "  fix formatting: cargo fmt --all   (and resolve any doc-link errors)"
    exit 1
fi
