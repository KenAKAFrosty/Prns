      <url>https://github.com/expo</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/expo/expo-modules-v2-android.git</connection>
    <developerConnection>scm:git:ssh://github.com/expo/expo-modules-v2-android.git</developerConnection>
    <url>https://github.com/expo/expo-modules-v2-android</url>
