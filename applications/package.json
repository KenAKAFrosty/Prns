{
  "name": "prns-applications",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "prns/app",
    "sdk/expo",
    "prns/native-composition/bindings"
  ],
  "scripts": {
    "api:generate": "python3 tools/generated-bindings/generate.py generate",
    "api:check": "python3 tools/generated-bindings/generate.py generate --check",
    "compatibility:check": "python3 ci/check_compatibility.py",
    "compatibility:test": "python3 -m unittest discover --start-directory ci --pattern 'test_*.py' --verbose",
    "mobility:test": "python3 -m unittest discover --start-directory tools/detached-consumer-check --pattern 'test_*.py' --verbose",
    "mobility:verify": "bash ci/verify_detached.sh",
    "lxmf:verify": "bash ci/verify_lxmf.sh",
    "native:test": "cargo test --locked --manifest-path Cargo.toml -p prns-app-native --features host-test,android",
    "native:verify": "npm run compatibility:check && npm run bindings:test && npm run api:check && npm run native:test && npm --prefix sdk/expo run verify:code",
    "native:ios:client": "bash sdk/expo/ios/build-development-client.sh",
    "native:ios:device": "bash sdk/expo/ios/build-development-client.sh --device",
    "native:ios": "npm run native:ios:client",
    "native:android:client": "bash sdk/expo/android/build-client.sh",
    "native:android:standalone": "bash sdk/expo/android/build-client.sh --standalone",
    "start": "npm --prefix prns/app run start",
    "start:web": "npm --prefix prns/app run start:web",
    "versions:check": "npm --prefix prns/app run versions:check",
    "format:check": "npm --prefix prns/app run format:check",
    "lint": "npm --prefix prns/app run lint",
    "typecheck": "npm --prefix prns/app run typecheck",
    "routes:check": "npm --prefix prns/app run routes:check",
    "config:check": "npm --prefix prns/app run config:check",
    "expo:check": "npm --prefix prns/app run expo:check",
    "doctor": "npm --prefix prns/app run doctor",
    "test": "npm --prefix sdk/expo run test && npm --prefix prns/app run test",
    "export:web": "npm --prefix prns/app run export:web",
    "verify": "npm run compatibility:test && npm run mobility:test && npm run native:verify && npm --prefix prns/app run verify",
    "bindings:ios": "python3 tools/generated-bindings/generate.py ios",
    "bindings:android": "python3 tools/generated-bindings/generate.py android",
    "bindings:test": "python3 tools/ubrn-vendor/vendor.py check && python3 -m unittest discover --start-directory tools/generated-bindings --pattern 'test_*.py' --verbose && node --test prns/native-composition/bindings/tests/host_adapter.test.mjs && python3 -m unittest discover --start-directory tools/ubrn-vendor --pattern 'test_*.py' --verbose",
    "native:ios:test": "npm --prefix sdk/expo run ios:test"
  }
}
