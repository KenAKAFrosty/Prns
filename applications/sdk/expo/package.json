{
  "name": "@prns-internal/expo",
  "version": "0.0.0",
  "private": true,
  "description": "App-owned Expo bridge for the prns development runtime",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "api:check": "python3 ../../tools/generated-bindings/generate.py generate --check",
    "ios:check": "node scripts/check-ios-bridge.mjs",
    "format:check": "biome format .",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "verify": "npm run api:check && npm run ios:check && npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@ubjs/core": "file:../../vendor/ubrn/packages/ubjs-core-0.31.0-5.tgz",
    "effect": "4.0.0-rc.112",
    "personal-rns": "file:../../../prns-js",
    "@prns-internal/native-bindings": "*"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "7.0.2"
  }
}
