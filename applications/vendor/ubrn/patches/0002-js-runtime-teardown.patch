+  const std::string pollMarker = "_rust_future_poll_";
+  for (auto &poll : fns) {
+    const auto marker = poll.name.find(pollMarker);
+    if (poll.name.rfind("ffi_", 0) != 0 || marker == std::string::npos ||
+        poll.args.size() != 3 || poll.args[0].tag != UBRN_TY_HANDLE ||
+        poll.args[1].tag != UBRN_TY_CALLBACK ||
+        poll.args[1].name != "RustFutureContinuationCallback" ||
+        poll.args[2].tag != UBRN_TY_HANDLE || poll.retTag != UBRN_TY_VOID ||
+        poll.hasRcs) {
