+          free.args[0].tag == UBRN_TY_HANDLE && free.retTag == UBRN_TY_VOID &&
+          !free.hasRcs) {
+        poll.futureFree = free.name;
+        free.isFutureFree = true;
+        break;
+      }
+    }
