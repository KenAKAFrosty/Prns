@@ -0,0 +1,94 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/
+ */
+import { asyncTest } from "@/asserts";
+import { uniffiRustFutureHandleCount } from "@ubjs/core";
+import theModule, {
+  activeQueryCount,
+  delayedQuery,
+  noteIteration,
+  processWorkCompleted,
+} from "@/generated/reload_safety";
+import nativeModule from "@/generated/reload_safety-ffi";
+
+theModule.initialize();
+
+declare const __testRequestReload: () => void;
+const delay = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+void asyncTest(
+  "pending async calls are released when JavaScript is replaced",
+  async (t) => {
+    const iteration = noteIteration();
+    const diagnostics = nativeModule() as unknown as {
+      $uniffiTrampolineCount(): number;
+    };
+    // New module initialization happens before any abandoned worker wakes.
+    t.assertEqual(
+      activeQueryCount(),
+      0,
+      "destroyed runtime must release pending Rust futures",
+    );
+    t.assertEqual(
+      uniffiRustFutureHandleCount(),
+      0,
+      "replacement starts with no JS resolvers",
+    );
+    if (iteration > 1) {
+      await delay(500);
+      t.assertEqual(
+        processWorkCompleted(),
+        (iteration - 1) * 14,
+        "the same Rust process state survives each replacement",
+      );
+    }
+
+    t.assertEqual(activeQueryCount(), 0);
+    await delayedQuery(5);
+    t.assertEqual(activeQueryCount(), 0, "completed query releases its future");
+    const trampolines = diagnostics.$uniffiTrampolineCount();
+    const abort = new AbortController();
+    const cancelled = delayedQuery(250, { signal: abort.signal });
+    abort.abort();
+    let aborted = false;
+    try {
+      await cancelled;
+    } catch (error) {
+      aborted = (error as Error).name === "AbortError";
+    }
+    t.assertTrue(aborted, "explicit cancellation rejects the promise");
+    t.assertEqual(
+      activeQueryCount(),
+      0,
+      "explicit cancellation releases its future",
+    );
+    t.assertEqual(
+      uniffiRustFutureHandleCount(),
+      0,
+      "no completed/cancelled resolver retained",
+    );
+    for (let i = 0; i < 12; i++) {
+      void delayedQuery(350);
+    }
+    t.assertEqual(
+      activeQueryCount(),
+      12,
+      "queries really are pending at teardown",
+    );
+    t.assertEqual(uniffiRustFutureHandleCount(), 12);
+    t.assertEqual(
+      diagnostics.$uniffiTrampolineCount(),
+      trampolines,
+      "async polling reuses its continuation trampoline",
+    );
+    console.info(
+      `iteration ${iteration}: completed/cancelled futures released; 12 pending at teardown`,
+    );
+    t.end();
+    __testRequestReload();
+  },
+  10000,
+);
