+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn arguments() -> Vec<general::FfiArgument> {
+        ["import", "package", "ordinary_name"]
+            .into_iter()
+            .map(|name| general::FfiArgument {
+                name: name.into(),
+                ty: general::FfiTypeNode {
+                    ty: general::FfiType::UInt32,
+                },
+            })
+            .collect()
+    }
+
+    #[test]
+    fn ffi_function_arguments_escape_keywords_without_changing_symbols_or_status() {
+        let function = general::FfiFunction {
+            name: general::RustFfiFunctionName("exact_native_symbol".into()),
+            is_async: false,
+            async_data: None,
+            arguments: arguments(),
+            return_type: general::FfiReturnType { ty: None },
+            has_rust_call_status_arg: true,
+            kind: general::FfiFunctionKind::Scaffolding,
+        };
+        for internal in [false, true] {
+            let output = TsFfiModule::map_ffi_function(&function, internal);
+            assert_eq!(output.name, "ubrn_exact_native_symbol");
+            let names: Vec<_> = output
+                .arguments
+                .iter()
+                .map(|arg| arg.name.as_str())
+                .collect();
+            assert_eq!(
+                names,
+                ["import_", "package_", "ordinaryName", "uniffi_out_err"]
+            );
+        }
+    }
+
+    #[test]
+    fn ffi_callback_arguments_use_the_same_keyword_names() {
+        let callback = general::FfiFunctionType {
+            name: general::FfiFunctionTypeName("CallbackInterfaceExample".into()),
+            arguments: arguments(),
+            return_type: general::FfiReturnType { ty: None },
+            has_rust_call_status_arg: false,
+        };
+        let output = TsFfiModule::map_callback(&callback);
+        let names: Vec<_> = output
+            .arguments
+            .iter()
+            .map(|arg| arg.name.as_str())
+            .collect();
+        assert_eq!(names, ["import_", "package_", "ordinaryName"]);
+    }
+}
