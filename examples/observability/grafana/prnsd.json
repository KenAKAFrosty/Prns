    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One bounded row per configured logical interface. Fleet peers roll up beneath their TCP, Wi-Fi, Bluetooth, backbone, WebSocket, or shared-instance supervisor.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "interface_kind"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Kind"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "blue",
                        "text": "Initializing"
                      },
                      "1": {
                        "color": "green",
                        "text": "Connected"
                      },
                      "2": {
                        "color": "yellow",
                        "text": "Degraded"
                      },
                      "3": {
                        "color": "yellow",
                        "text": "Reconnecting"
                      },
                      "4": {
                        "color": "red",
                        "text": "Failed"
                      },
                      "5": {
                        "color": "orange",
                        "text": "Disconnected"
                      },
                      "6": {
                        "color": "text",
                        "text": "Disabled"
                      },
                      "255": {
                        "color": "text",
                        "text": "Unknown"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(RX|TX)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(Announce in|Announce out)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
