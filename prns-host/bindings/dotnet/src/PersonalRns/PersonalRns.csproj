<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>PersonalRns</PackageId>
    <Version>0.2.8</Version>
    <Authors>Personal RNS contributors</Authors>
    <Description>Correct, robust, fast .NET bindings for Personal Reticulum.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KenAKAFrosty/Prns</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
