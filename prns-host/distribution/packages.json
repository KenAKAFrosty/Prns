  "packages": [
    {
      "ecosystem": "npm",
      "name": "personal-rns",
      "manifest": "prns-js/package.json"
    },
    {
      "ecosystem": "npm",
      "name": "hopspot",
      "manifest": "personal-hopspot/sdk/hopspot/package.json"
    },
    {
      "ecosystem": "pypi",
      "name": "personal-rns",
