    {
      "ecosystem": "c",
      "name": "personal-rns",
      "manifest": "prns-host/abi/c/include/prns_host.h",
      "tag": "host-sdk-v{version}"
    },
    {
      "ecosystem": "cpp",
      "name": "personal-rns",
      "manifest": "prns-host/abi/c/include/prns_host.h",
