{
  "name": "@personal-rns/wasm-backend",
  "version": "0.3.8",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:package:wasm": "node scripts/build-wasm.mjs --release",
    "build:browser": "npm run build:wasm && npm run build:smoke",
    "build:playground": "npm run build:playground:wasm && npm run build:playground:ts",
    "build:playground:wasm": "node scripts/build-wasm.mjs --release --out-dir target/browser-playground/pkg",
    "build:playground:ts": "tsc -p examples/browser-playground/tsconfig.json",
    "build:smoke": "tsc -p tsconfig.json && node scripts/stage-event-smoke.mjs",
    "stage:docs": "../tools/prns build wasm-docs stage",
    "test:build": "node --test scripts/build-wasm.test.mjs",
    "check": "npm run test:build && tsc -p tsconfig.json --noEmit",
    "check:casework": "npm run build:smoke && node smoke/dist/prns-wasm/smoke/casework-smoke.js",
    "check:events": "npm run build:smoke && node smoke/dist/prns-wasm/smoke/event-smoke.js",
    "check:auto-wifi": "npm run build:smoke && node smoke/dist/prns-wasm/smoke/auto-wifi-smoke.js",
    "check:websocket": "npm run build:smoke && node smoke/dist/prns-wasm/smoke/websocket-smoke.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
