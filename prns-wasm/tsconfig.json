{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "/pkg/prns_wasm.js": ["../prns-js/src/browser/wasm_web.d.ts"]
    },
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "rootDir": "..",
    "outDir": "./smoke/dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "../prns-js/src/casework.ts",
    "../prns-js/src/browser/**/*.ts",
    "examples/browser-playground/presentation.ts",
    "smoke/**/*.ts"
  ],
  "exclude": ["smoke/dist", "smoke/pkg"]
}
