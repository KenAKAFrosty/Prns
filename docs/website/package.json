{
  "name": "reticulum-site-assets",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Tailwind v4 build tooling for the reticulum.rs Dioxus site. Rust is the application language; this manifest exists only because the official Tailwind v4 toolchain ships via npm.",
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.css -o ./public/assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.css -o ./public/assets/tailwind.css --watch",
    "build:flasher": "esbuild web-flasher/src/prns-flash.js --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=target/hosted-assets/prns-flash.js",
    "test:flasher": "node --test web-flasher/test/*.test.mjs"
  },
  "dependencies": {
    "esptool-js": "0.6.0",
    "spark-md5": "3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3"
  }
}
